@model Compra
@{ ViewData["Title"] = "Lançamento Manual"; var notas = ViewBag.Notas as List<NotaFiscal> ?? new List<NotaFiscal>(); }
<header class="page-header"><h1>Lançar Compra Manualmente</h1><p>Cadastre os dados da compra e, se quiser, vincule uma nota fiscal enviada.</p></header>
<div class="form-card">
<form asp-action="Manual" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="validation"></div>
<label asp-for="Descricao">Descrição da compra</label><input asp-for="Descricao" placeholder="Ex.: Compra no supermercado" /><span asp-validation-for="Descricao" class="validation"></span>
<div class="form-grid">
<div><label asp-for="Valor">Valor (R$)</label><input asp-for="Valor" type="number" step="0.01" min="0.01" placeholder="0,00" /><span asp-validation-for="Valor" class="validation"></span></div>
<div><label asp-for="DataCompra">Data da compra</label><input asp-for="DataCompra" type="date" /></div>
</div>
<label asp-for="Categoria">Categoria</label>
<select asp-for="Categoria">
<option>Alimentação</option><option>Transporte</option><option>Moradia</option><option>Saúde</option><option>Educação</option><option>Lazer</option><option>Outros</option>
</select>
<label asp-for="Observacoes">Observações (opcional)</label><textarea asp-for="Observacoes" rows="3" placeholder="Detalhes adicionais"></textarea>
<label for="notaFiscalId">Vincular nota fiscal enviada (opcional)</label>
<select name="notaFiscalId" id="notaFiscalId"><option value="">Nenhuma nota</option>@foreach (var n in notas) { <option value="@n.Id">@n.NomeArquivo</option> }</select>
<div class="form-actions"><a class="secondary-button" asp-action="Index">Cancelar</a><button class="primary-button" type="submit">Salvar compra</button></div>
</form>
</div>
